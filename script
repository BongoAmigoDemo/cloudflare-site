async function loadAiNews() {
  const newsContainer = document.getElementById('news-list');
  if (!newsContainer) return;

  try {
    const response = await fetch('/api/news');
    if (!response.ok) throw new Error(`Server returned ${response.status}`);

    const data = await response.json();
    const items = data.items || [];

    if (items.length === 0) {
      newsContainer.innerHTML = '<p>No news found.</p>';
      return;
    }

    newsContainer.innerHTML = items.map(item => `
      <div class="news-item" style="margin-bottom: 1.25rem;">
        <h3 style="margin-bottom: 0.25rem;">
          <a href="${item.link}" target="_blank" rel="noopener" style="color: #38bdf8; text-decoration: none;">
            ${item.title}
          </a>
        </h3>
        <p style="color: #94a3b8; font-size: 0.85rem;">
          ${new Date(item.pubDate).toLocaleDateString()}
        </p>
      </div>
    `).join('');

  } catch (error) {
    console.error('Error loading news:', error);
    newsContainer.innerHTML = '<p>Could not load news at this time.</p>';
  }
}

document.addEventListener('DOMContentLoaded', loadAiNews);
